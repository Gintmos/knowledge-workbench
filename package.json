{
  "name": "knowledge-workbench",
  "version": "1.0.5",
  "private": true,
  "description": "Obsidian plugin: vault-local knowledge classification, tasks, review plan and note reading. No backend, no network requests.",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs --production && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "node scripts/run-tests.mjs",
    "link-vault": "node scripts/link-vault.mjs",
    "release:check": "node scripts/release-check.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "ics:samples": "node scripts/ics-samples.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.1",
    "obsidian": "latest",
    "typescript": "^5.6.3"
  }
}
